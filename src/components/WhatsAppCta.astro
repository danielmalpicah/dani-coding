---
import { WHATSAPP_MESSAGE, waUrl } from '../lib/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  class?: string;
  iconSize?: number;
  ariaLabel?: string;
  src: string; // origen del lead, ver waUrl
}

const { class: className = '', iconSize = 16, ariaLabel, src } = Astro.props;
---

<a
  href={waUrl(WHATSAPP_MESSAGE, src)}
  target="_blank"
  rel="noopener noreferrer"
  class={className}
  aria-label={ariaLabel}
>
  <WhatsAppIcon size={iconSize} />
  <slot />
</a>
